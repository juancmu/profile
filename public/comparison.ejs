<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- DataTables Bootstrap 5 -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            --glass-bg: rgba(255, 255, 255, 0.95);
            --glass-border: rgba(255, 255, 255, 0.2);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f0f2f5;
            color: #1e293b;
            min-height: 100vh;
        }

        .navbar {
            background: var(--primary-gradient);
            padding: 1.5rem 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: -0.025em;
            color: white !important;
        }

        .container-fluid {
            padding: 2rem;
        }

        .card {
            border: none;
            border-radius: 1.5rem;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            border: 1px solid var(--glass-border);
        }

        .card-header {
            background: transparent;
            padding: 2rem;
            border-bottom: 1px solid #e2e8f0;
        }

        .card-title {
            font-weight: 700;
            font-size: 1.25rem;
            color: #0f172a;
            margin: 0;
        }

        .table-container {
            padding: 1.5rem;
        }

        table.dataTable {
            border-collapse: separate !important;
            border-spacing: 0 0.5rem !important;
            width: 100% !important;
        }

        table.dataTable thead th {
            font-size: 0.85rem;
            font-weight: 600;
            color: #475569;
            padding: 1rem 1.5rem !important;
            border-bottom: 2px solid #cbd5e1 !important;
            background-color: #f8fafc;
            white-space: nowrap;
        }

        /* Based on the user's excel image, making the rightmost headers a bit different */
        table.dataTable thead th.parcel-col {
            background-color: #f8fafc;
        }

        table.dataTable thead th.parcel-col-highlight {
            background-color: #fef08a !important;
            /* Yellow highlight like the excel column */
            color: #854d0e !important;
        }

        table.dataTable tbody tr {
            background-color: white;
            transition: all 0.2s;
        }

        table.dataTable tbody tr:hover {
            background-color: #f1f5f9 !important;
        }

        table.dataTable tbody td {
            padding: 0.75rem 1.5rem !important;
            vertical-align: middle;
            border-bottom: 1px solid #e2e8f0 !important;
            font-size: 0.9rem;
            white-space: nowrap;
            border-right: 1px solid #f1f5f9;
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.9);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.5s;
        }

        .spinner-grow {
            width: 3rem;
            height: 3rem;
            color: #3b82f6;
        }

        footer {
            padding: 2rem;
            text-align: center;
            color: #64748b;
            font-size: 14px;
        }

        .dt-buttons .btn {
            margin-right: 0.5rem;
        }
    </style>
</head>

<body>
    <div id="loading" class="loading-overlay">
        <div class="spinner-grow" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 class="mt-4 fw-light text-muted">Processing Land Comparison...</h4>
    </div>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container-fluid py-0 px-3">
            <a class="navbar-brand d-flex align-items-center" href="/LANDS">
                <i class="bi bi-geo-alt-fill me-2 opacity-75"></i>
                CFRO GIS
            </a>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a href="/LANDS" class="btn btn-outline-light btn-sm rounded-pill px-3">
                    <i class="bi bi-house-door me-1"></i> Dashboard
                </a>
                <a href="/logout" class="btn btn-light btn-sm rounded-pill px-3 text-primary fw-semibold shadow-sm">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center py-3">
                <h5 class="card-title text-uppercase m-0">
                    <i class="bi bi-table me-2 text-primary"></i>
                    Lands Comparison View (RefName vs PARCEL_ID)
                </h5>
            </div>
            <div class="table-container table-responsive">
                <table id="comparison-table" class="table table-bordered w-100">
                    <thead id="table-head">
                        <!-- Headers injected dynamically -->
                    </thead>
                    <tbody id="table-body">
                        <!-- Data will be injected here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <footer>
        &copy; 2026 CFRO - Regiotram GIS System
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        async function loadGeoJSON(url) {
            try {
                const resp = await fetch(url);
                if (!resp.ok) return null; // Gracefully handle missing files
                return await resp.json();
            } catch (e) {
                console.warn(`Failed to load ${url}`);
                return null;
            }
        }

        $(document).ready(async function () {
            try {
                const urls = [
                    { url: '/data/landsEFR.geojson', type: 'Project' },
                    { url: '/data/landsUtil.geojson', type: 'Utilities' },
                    { url: '/data/landsComp.geojson', type: 'Secondary' }
                ];

                const results = await Promise.all(urls.map(u => loadGeoJSON(u.url)));

                console.log(results)

                // Group PARCEL_IDs by RefName
                const grouped = {};

                results.forEach((data, index) => {
                    if (!data || !data.features) return;

                    const currentType = urls[index].type;

                    data.features.forEach(feature => {
                        const props = feature.properties;
                        if (props) {
                            let refName = props.RefName;
                            const parcelId = props.PARCEL_ID;
                            const acta = props.ACTA_No;

                            console.log(refName + "/-->" + acta)

                            if (refName && parcelId) {
                                refName = String(refName).trim();
                                const currentStatus = props.EFR_ENTRG || 'UNKNOWN';
                                const currentStatusUpper = currentStatus.toUpperCase();

                                if (!grouped[refName]) {
                                    grouped[refName] = {
                                        sector: props.SECTOR || 'UNKNOWN',
                                        type: currentType,
                                        status: currentStatus,
                                        acta_no: props.ACTA_No != null ? props.ACTA_No : '',
                                        parcels: new Map()
                                    };
                                } else {
                                    // If any parcel within this group is NO DELIVERED, flag the whole group
                                    if (currentStatusUpper === "NO DELIVERED" || currentStatusUpper === "NOT_DELIVERED") {
                                        grouped[refName].status = currentStatus;
                                    }
                                    // Update ACTA_No if not yet set and current feature has it
                                    if ((!grouped[refName].acta_no || grouped[refName].acta_no === '') && props.ACTA_No != null) {
                                        grouped[refName].acta_no = props.ACTA_No;
                                    }
                                }

                                grouped[refName].parcels.set(String(parcelId).trim(), {
                                    status: currentStatus
                                });
                            }
                        }
                    });
                });

                // Determine the maximum number of parcels for any RefName
                let maxParcels = 0;
                const processedData = [];

                for (const [refName, dataObj] of Object.entries(grouped)) {
                    // Sort parcels by id for consistent display
                    const parcels = Array.from(dataObj.parcels.entries())
                        .map(([id, pData]) => ({ id, status: pData.status }))
                        .sort((a, b) => a.id.localeCompare(b.id));

                    if (parcels.length > maxParcels) {
                        maxParcels = parcels.length;
                    }

                    processedData.push({
                        refName: refName,
                        sector: dataObj.sector,
                        type: dataObj.type,
                        status: dataObj.status,
                        acta_no: dataObj.acta_no,
                        parcels: parcels
                    });
                }

                // Ensure at least 5 columns if data has fewer, to match excel look
                const displayCols = Math.max(5, maxParcels);

                // Build Table Headers dynamically
                let theadHtml = '<tr><th>RefName</th><th>Sector</th><th>Type</th><th>Status (Main)</th><th>Acta_No</th>';
                for (let i = 1; i <= displayCols; i++) {
                    const highlightClass = i === displayCols ? 'parcel-col-highlight' : 'parcel-col';
                    theadHtml += `<th class="${highlightClass}">PARCEL_ID_${i}</th>`;
                }
                theadHtml += '</tr>';
                $('#table-head').html(theadHtml);

                // Sort RefNames naturally
                processedData.sort((a, b) => {
                    return a.refName.localeCompare(b.refName, undefined, { numeric: true, sensitivity: 'base' });
                });

                // Build Table Body dynamically
                let tbodyHtml = '';
                console.log(processedData);
                processedData.forEach(row => {

                    tbodyHtml += `<tr>`;
                    tbodyHtml += `<td><strong>${row.refName}</strong></td>`;

                    const sectorClass = row.sector.toUpperCase() === 'URBANO' ? 'bg-success bg-opacity-10 text-success' : 'bg-danger bg-opacity-10 text-danger';
                    tbodyHtml += `<td><span class="badge rounded-pill ${sectorClass}">${row.sector}</span></td>`;
                    tbodyHtml += `<td><span class="badge bg-secondary opacity-75">${row.type}</span></td>`;

                    const statusClass = (row.status.toUpperCase() === "NO DELIVERED" || row.status.toUpperCase() === "NOT_DELIVERED") ? 'text-danger fw-bold' : 'text-success fw-bold';
                    tbodyHtml += `<td class="${statusClass}">${row.status}</td>`;
                    tbodyHtml += `<td>${row.acta_no}</td>`;

                    for (let i = 0; i < displayCols; i++) {
                        const cellData = row.parcels[i];
                        if (cellData) {
                            let bgClass = '';
                            if (cellData.status.toUpperCase() === "DELIVERED") {
                                bgClass = 'bg-success text-white fw-bold';
                            } else if (cellData.status.toUpperCase() === "NO DELIVERED" || cellData.status.toUpperCase() === "NOT_DELIVERED") {
                                bgClass = 'bg-danger text-white fw-bold';
                            } else {
                                bgClass = 'bg-light';
                            }
                            tbodyHtml += `<td class="${bgClass}">${cellData.id}</td>`;
                        } else {
                            tbodyHtml += `<td></td>`;
                        }
                    }

                    tbodyHtml += `</tr>`;
                });
                $('#table-body').html(tbodyHtml);

                // Initialize DataTable
                const table = $('#comparison-table').DataTable({
                    order: [], // keep our manual sort
                    pageLength: 50,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search any field..."
                    },
                    dom: '<"d-flex flex-wrap justify-content-between align-items-center mb-3"liBf>rtip',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            text: '<i class="bi bi-file-earmark-excel me-1"></i> Export to XLSX',
                            className: 'btn btn-success btn-sm rounded-pill px-3 shadow-sm border-0',
                            title: 'Lands_Comparison_Report_' + new Date().toISOString().split('T')[0]
                        }
                    ],
                    initComplete: function () {
                        this.api().columns().every(function () {
                            var column = this;
                            var headerText = $(column.header()).text().trim().toUpperCase();

                            // Target columns: TYPE, SECTOR
                            if (headerText === 'TYPE' || headerText === 'SECTOR') {
                                var select = $('<select class="form-select form-select-sm mt-2 fw-normal" style="min-width: 100px; display: inline-block; width: auto;"><option value="">All</option></select>')
                                    .appendTo($(column.header()))
                                    .on('change', function () {
                                        var val = $.fn.dataTable.util.escapeRegex($(this).val());
                                        column.search(val ? '^' + val + '$' : '', true, false).draw();
                                    });

                                // Prevent sorting when clicking the select
                                select.on('click', function (e) {
                                    e.stopPropagation();
                                });

                                var uniqueData = [];
                                column.data().unique().sort().each(function (d, j) {
                                    var text = $('<div>').html(d).text().trim();
                                    if (text && uniqueData.indexOf(text) === -1) {
                                        uniqueData.push(text);
                                    }
                                });

                                uniqueData.sort().forEach(function (val) {
                                    select.append('<option value="' + val + '">' + val + '</option>');
                                });
                            }
                        });
                    }
                });

                $('#loading').fadeOut();

            } catch (error) {
                console.error("Error loading comparison data:", error);
                alert("Failed to load comparison data. Check console.");
                $('#loading').fadeOut();
            }
        });
    </script>
</body>

</html>